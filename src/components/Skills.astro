---
import SectionTitle from "./SectionTitle.astro";

const rowA = [
  ["javascript", "JavaScript"], ["typescript", "TypeScript"], ["react", "React"], ["nextjs", "Next.js"],
  ["nodejs", "Node.js"], ["nestjs", "NestJS"], ["express", "Express"], ["astro", "Astro"], ["angular", "Angular"],
  ["tailwindcss", "Tailwind"], ["html5", "HTML5"], ["css", "CSS"],
];
const rowB = [
  ["php", "PHP"], ["laravel", "Laravel"], ["symfony", "Symfony"], ["mysql", "MySQL"], ["postgresql", "PostgreSQL"],
  ["prisma", "Prisma"], ["docker", "Docker"], ["git", "Git"], ["github", "GitHub"], ["vercel", "Vercel"],
  ["netlify", "Netlify"], ["render", "Render"], ["postman", "Postman"], ["ubuntu", "Ubuntu"],
];
const rows = [
  { items: rowA, anim: "animate-marquee" },
  { items: rowB, anim: "animate-marquee-reverse" },
];
---
<section id="skills" class="py-16 md:py-24">
  <div class="px-4">
    <div class="mx-auto max-w-6xl">
      <SectionTitle
        num="05"
        kicker="Stack"
        title="Con qué trabajo"
        intro="Mi día a día es JavaScript de punta a punta, pero también me muevo con soltura en PHP."
      />
    </div>
  </div>

  <div class="space-y-4 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
    {rows.map((row) => (
      <div class={`flex w-max gap-4 ${row.anim} hover:[animation-play-state:paused]`}>
        {[...row.items, ...row.items].map(([icon, label], i) => (
          <div class="flex shrink-0 items-center gap-3 rounded-full border border-ink/10 bg-white px-5 py-3 font-semibold" aria-hidden={i >= row.items.length ? "true" : undefined}>
            <img src={`/icons/${icon}.svg`} alt="" class="h-7 w-7" loading="lazy" />
            {label}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
