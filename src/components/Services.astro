---
import SectionTitle from "./SectionTitle.astro";

const services = [
  {
    emoji: "🛠️",
    title: "Productos SaaS",
    text: "De la idea al lanzamiento: diseño, desarrollo full-stack, pagos y despliegue. Lo mismo que hago con mis propios productos.",
    dot: "bg-lemon",
  },
  {
    emoji: "🌐",
    title: "Webs para negocios",
    text: "Webs rápidas y modernas, pensadas para convertir visitas en clientes. Rediseño webs anticuadas o las creo desde cero.",
    dot: "bg-sea",
  },
  {
    emoji: "🎓",
    title: "Clases de programación",
    text: "Clases particulares de desarrollo web para todos los niveles, desde los fundamentos de JavaScript hasta proyectos full-stack.",
    dot: "bg-sonic",
  },
];
---

<section id="servicios" class="px-4 py-16 md:py-24">
  <div class="mx-auto max-w-6xl">
    <SectionTitle num="02" kicker="Qué hago" title="¿En qué te ayudo?" />

    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      {services.map((s) => (
        <div class="border-t-2 border-ink pt-6">
          <div class="mb-5 flex items-center justify-between">
            <span class="text-4xl">{s.emoji}</span>
            <span class={`h-4 w-4 rounded-full ${s.dot}`}></span>
          </div>
          <h3 class="text-2xl font-bold">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-ink/70">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
