---
import SectionTitle from "./SectionTitle.astro";

const link = "font-semibold text-sonic underline decoration-sonic/30 underline-offset-4 transition hover:decoration-sonic";
---

<section id="experiencia" class="px-4 py-16 md:py-24">
  <div class="mx-auto max-w-6xl">
    <SectionTitle num="04" kicker="Trayectoria" title="Dónde he estado" />

    <ol class="border-b border-ink/15">
      <li class="grid gap-2 border-t border-ink/15 py-8 md:grid-cols-[200px_1fr] md:gap-10">
        <p class="font-display text-lg font-bold">
          2022 — Hoy
          <span class="ml-2 inline-block rounded-full bg-lemon px-2 py-0.5 align-middle text-xs">Actual</span>
        </p>
        <div>
          <h3 class="text-2xl font-bold">Profesor de programación <span class="font-normal text-ink/50">· Remoto</span></h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">
            Clases particulares para alumnos de todos los niveles. Colaboro con
            <a href="https://mentoor.es/" target="_blank" rel="noopener" class={link}>Mentoor</a>
            y doy clases a través de
            <a href="https://www.tusclasesparticulares.com/profesores/issa-mayimout.htm" target="_blank" rel="noopener" class={link}>TusClasesParticulares</a>
            y
            <a href="https://www.superprof.es/tecnico-desarrollo-aplicaciones-web-clases-javascript-basico-hasta-avanzado-con-enfoque-front-end.html" target="_blank" rel="noopener" class={link}>Superprof</a>.
          </p>
        </div>
      </li>

      <li class="grid gap-2 border-t border-ink/15 py-8 md:grid-cols-[200px_1fr] md:gap-10">
        <p class="font-display text-lg font-bold">2020 — 2025</p>
        <div>
          <h3 class="text-2xl font-bold">Full-Stack Developer <span class="font-normal text-ink/50">· Equipo de Imagen</span></h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">
            Desarrollo y mantenimiento de webs a medida para clientes reales. Responsable del área técnica dentro de un equipo multidisciplinar.
          </p>
        </div>
      </li>

      <li class="grid gap-2 border-t border-ink/15 py-8 md:grid-cols-[200px_1fr] md:gap-10">
        <p class="font-display text-lg font-bold">2020</p>
        <div>
          <h3 class="text-2xl font-bold">Junior Developer <span class="font-normal text-ink/50">· NTTData</span></h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">
            Aplicación para generar documentos a partir de una base de datos relacional. Proyecto real con TypeScript.
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>
