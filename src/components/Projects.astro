---
import SectionTitle from "./SectionTitle.astro";

const projects = [
  {
    name: "Ustadi",
    url: "https://ustadi-virid.vercel.app/",
    icon: "/icons/brand/ustadi-icon.png",
    status: "Online",
    tagline: "Clases particulares en Mauritania",
    description:
      "Marketplace que conecta alumnos con profesores particulares en Mauritania, al estilo de Superprof. Se busca por asignatura, nivel, ciudad y presupuesto, y se contacta directamente con el profesor, sin intermediarios ni comisiones.",
    highlights: ["Árabe · Francés · Inglés", "Reseñas de alumnos", "De primaria a universidad"],
    tile: "bg-gradient-to-br from-sea to-lemon/70",
  },
  {
    name: "Norn",
    url: "https://nornapp.app/",
    icon: "/icons/brand/norn-mark.png",
    status: "Online",
    tagline: "Clientes para quien vende webs",
    description:
      "Herramienta de prospección para freelancers y agencias. Encuentra negocios locales sin web o con una web mala, los puntúa según la oportunidad de venta y permite seguir cada lead desde el primer contacto hasta el cierre.",
    highlights: ["Scoring de oportunidad", "Pipeline de ventas", "Suscripción con Stripe"],
    tile: "bg-gradient-to-br from-lemon to-sea",
  },
  {
    name: "Trabexia",
    url: "https://trabexia-micro-saas.vercel.app/",
    icon: "/icons/brand/trabexia-mark.png",
    status: "Lo uso a diario",
    tagline: "Empleo en Europa",
    description:
      "Portal de empleo para perfiles de logística, transporte y mantenimiento. El tráfico llega desde mi cuenta de TikTok; yo filtro a los candidatos y los paso a reclutadores que los colocan en España, Alemania e Irlanda. Es mi herramienta de trabajo diaria.",
    highlights: ["Captación vía TikTok", "Candidatos para toda Europa", "En uso real cada día"],
    tile: "bg-gradient-to-br from-sea/70 to-sonic/60",
  },
];
---

<section id="proyectos" class="px-4 py-16 md:py-24">
  <div class="mx-auto max-w-6xl">
    <SectionTitle
      num="01"
      kicker="Proyectos"
      title="Cosas que he lanzado"
      intro="Productos reales, en producción y con usuarios. Los he diseñado, programado y sacado adelante yo."
    />

    <div class="space-y-5">
      {projects.map((p, i) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="group grid items-center gap-6 rounded-[2rem] border border-ink/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-ink/20 hover:shadow-[0_24px_50px_-24px_rgb(15_27_45/0.35)] md:grid-cols-[auto_1fr_auto] md:gap-10 md:p-8"
        >
          <div class={`flex h-28 w-28 items-center justify-center rounded-3xl md:h-36 md:w-36 ${p.tile} ${i % 2 ? "rotate-3" : "-rotate-3"} transition duration-300 group-hover:rotate-0 group-hover:scale-105`}>
            <img src={p.icon} alt={`Logo de ${p.name}`} class="h-16 w-16 rounded-2xl object-contain md:h-20 md:w-20" loading="lazy" />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-3xl font-extrabold tracking-tight md:text-4xl">{p.name}</h3>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-lemon px-3 py-1 text-xs font-bold">
                <span class="h-1.5 w-1.5 rounded-full bg-ink"></span>{p.status}
              </span>
            </div>
            <p class="mt-1 font-semibold text-sonic">{p.tagline}</p>
            <p class="mt-3 max-w-2xl leading-relaxed text-ink/70">{p.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.highlights.map((h) => <li class="tag">{h}</li>)}
            </ul>
          </div>

          <span class="hidden h-14 w-14 items-center justify-center rounded-full bg-ink text-2xl text-lemon transition duration-300 group-hover:-rotate-45 group-hover:bg-sonic group-hover:text-white md:flex" aria-hidden="true">
            →
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
